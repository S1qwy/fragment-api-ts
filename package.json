{
  "name": "fragment-api-ts",
  "version": "2.0.0",
  "description": "Async client for interacting with Fragment.com marketplace and Telegram services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "fragment",
    "telegram",
    "ton",
    "stars",
    "premium",
    "giveaway",
    "marketplace",
    "session-storage",
    "redis"
  ],
  "author": "S1qwy <S1qwy@internet.ru>",
  "license": "MIT",
  "dependencies": {
    "@ton/core": "^0.62.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.4.0",
    "cheerio": "^1.0.0-rc.12",
    "qrcode-terminal": "^0.12.0",
    "tough-cookie": "^4.1.3",
    "tweetnacl": "^1.0.3"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/tough-cookie": "^4.0.5",
    "ioredis": "^5.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
} 