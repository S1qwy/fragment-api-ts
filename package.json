{
  "name": "fragment-api-ts",
  "version": "3.0.0",
  "description": "Async Fragment SDK with restricted wallet authentication, external signing, exact payment accounting, and explicit receipts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "fragment",
    "telegram",
    "ton",
    "stars",
    "premium",
    "giveaway",
    "marketplace",
    "external-signing",
    "session-storage"
  ],
  "author": "S1qwy <S1qwy@internet.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/S1qwy/fragment-api-ts.git"
  },
  "dependencies": {
    "@ton/core": "^0.62.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.4.0",
    "cheerio": "1.0.0",
    "https-proxy-agent": "^7.0.6",
    "socks-proxy-agent": "^8.0.5",
    "tough-cookie": "^4.1.4",
    "qrcode-terminal": "^0.12.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/tough-cookie": "^4.0.5",
    "ioredis": "^5.4.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}